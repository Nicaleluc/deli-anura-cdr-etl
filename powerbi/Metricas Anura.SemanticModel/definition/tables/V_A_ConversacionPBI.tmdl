table V_A_ConversacionPBI
	lineageTag: bfed2c1f6a0150ae98d1a80ee9c08ab4

	measure Llamadas = CALCULATE(COUNTROWS(V_A_ConversacionPBI), V_A_ConversacionPBI[EsBuzon] <> "SI")
		formatString: 0
		lineageTag: b03ff642474e56949d86ab7c0c6d7a1e

	measure Minutos = DIVIDE(CALCULATE(SUM(V_A_ConversacionPBI[DuracionSeg]), V_A_ConversacionPBI[EsBuzon] <> "SI"), 60)
		formatString: #,##0
		lineageTag: 7effa81c904052d39edfd9c9b71c5853

	measure 'Seg Habla Tec' = CALCULATE(SUM(V_A_ConversacionPBI[SegTec]), V_A_ConversacionPBI[EsBuzon] <> "SI")
		formatString: #,##0
		lineageTag: 62d0c4f1112c55e18acfa6fcaefa6202

	measure 'Seg Habla Cli' = CALCULATE(SUM(V_A_ConversacionPBI[SegCli]), V_A_ConversacionPBI[EsBuzon] <> "SI")
		formatString: #,##0
		lineageTag: 791acc5624ee5d47b910c6f318fd7a44

	measure 'Dur Minima' = MIN(V_A_ConversacionPBI[DuracionSeg])
		formatString: 0
		lineageTag: e3dbbf6142e35fd0b0b507f768a2b047

	measure 'Dur P25' = PERCENTILE.INC(V_A_ConversacionPBI[DuracionSeg], 0.25)
		formatString: 0
		lineageTag: 1adf54f6ef9f58668b41b8d6cee10255

	measure 'Dur Mediana' = MEDIAN(V_A_ConversacionPBI[DuracionSeg])
		formatString: 0
		lineageTag: c829c6f352b459f2be505b8656491b91

	measure 'Dur P75' = PERCENTILE.INC(V_A_ConversacionPBI[DuracionSeg], 0.75)
		formatString: 0
		lineageTag: 838ec352c95a551cb06e2f8ead576322

	measure 'Dur Maxima' = MAX(V_A_ConversacionPBI[DuracionSeg])
		formatString: 0
		lineageTag: 35142377b4115f598879f492cb245918

	measure ALTA = CALCULATE(COUNTROWS(V_A_ConversacionPBI), V_A_ConversacionPBI[Confianza] = "ALTA")
		formatString: 0
		lineageTag: ec76b35a2927536492eb63a0dde84335

	measure '% ALTA' = DIVIDE([ALTA], [Llamadas])
		formatString: #0%
		lineageTag: 433546c5c8f75eddb413e9de3e33d252

	measure Desconocidas = CALCULATE(COUNTROWS(V_A_ConversacionPBI), V_A_ConversacionPBI[Tecnico] = "desconocido")
		formatString: 0
		lineageTag: bc1e5bfeee045d318aa55c14fd3a0f27

	measure 'Llamadas s/buzon' = CALCULATE(COUNTROWS(V_A_ConversacionPBI), V_A_ConversacionPBI[EsBuzon] <> "SI")
		formatString: 0
		lineageTag: 0b83ba63aa9f5ea8bd168ba923207245

	measure 'Dur Minima s/buzon' = CALCULATE(MIN(V_A_ConversacionPBI[DuracionSeg]), V_A_ConversacionPBI[EsBuzon] <> "SI")
		formatString: 0
		lineageTag: 7c78398fadce5b539a422d1a2538db68

	measure 'Dur P25 s/buzon' = CALCULATE(PERCENTILE.INC(V_A_ConversacionPBI[DuracionSeg], 0.25), V_A_ConversacionPBI[EsBuzon] <> "SI")
		formatString: 0
		lineageTag: 3b8ba1856d6850389544329f585c61f8

	measure 'Dur Mediana s/buzon' = CALCULATE(MEDIAN(V_A_ConversacionPBI[DuracionSeg]), V_A_ConversacionPBI[EsBuzon] <> "SI")
		formatString: 0
		lineageTag: 5dd391c1ede9564bbc9590998d33ee5c

	measure 'Dur P75 s/buzon' = CALCULATE(PERCENTILE.INC(V_A_ConversacionPBI[DuracionSeg], 0.75), V_A_ConversacionPBI[EsBuzon] <> "SI")
		formatString: 0
		lineageTag: f9df94052c025684b6d656c218c62c7b

	measure 'Dur Maxima s/buzon' = CALCULATE(MAX(V_A_ConversacionPBI[DuracionSeg]), V_A_ConversacionPBI[EsBuzon] <> "SI")
		formatString: 0
		lineageTag: 0196e4c71e5355a09743cd3d38bea611

	measure 'Total Día' = CALCULATE([Llamadas], REMOVEFILTERS(V_A_ConversacionPBI[Turno]))
		formatString: 0
		lineageTag: fdc559192a215f8897785ebd4b230029

	measure 'Total Llamadas' = CALCULATE([Llamadas], REMOVEFILTERS(V_A_ConversacionPBI[Turno]))
		formatString: 0
		lineageTag: 30ef91de-d26b-4cd6-a7c9-3bdf0e5521a7

	measure 'Total Minutos' = CALCULATE([Minutos], REMOVEFILTERS(V_A_ConversacionPBI[Turno]))
