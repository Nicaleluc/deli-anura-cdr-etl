table V_A_PerdidaRacha
	lineageTag: 1342150a6bb74c819ba49f99c14fd5c4

	measure Rachas = COUNTROWS(V_A_PerdidaRacha)
		formatString: 0
		lineageTag: 142a817f2995476c91fc214431e019f9

	measure 'Llamadas en racha' = SUM(V_A_PerdidaRacha[Cantidad])
		formatString: 0
		lineageTag: 740db1d67ab941dab5d0a56a13fde5e0

	measure '% Devueltas racha' = DIVIDE(CALCULATE(COUNTROWS(V_A_PerdidaRacha), V_A_PerdidaRacha[Devuelta] = "Si"), [Rachas])
		formatString: #0%
		lineageTag: 1241206a94c04755a90a1434685b954f

